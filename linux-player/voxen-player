#!/bin/sh
set -eu
APP_DIR=/opt/voxen-player
PORT=${VOXEN_PLAYER_PORT:-48731}
PROFILE_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/voxen-player

"$APP_DIR/runtime/node" "$APP_DIR/server.js" &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true' EXIT INT TERM

i=0
while [ "$i" -lt 40 ]; do
  if "$APP_DIR/runtime/node" -e "fetch('http://127.0.0.1:$PORT/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"; then break; fi
  i=$((i + 1)); sleep 0.1
done

if command -v google-chrome >/dev/null 2>&1; then BROWSER=google-chrome
elif command -v google-chrome-stable >/dev/null 2>&1; then BROWSER=google-chrome-stable
elif command -v chromium >/dev/null 2>&1; then BROWSER=chromium
elif command -v chromium-browser >/dev/null 2>&1; then BROWSER=chromium-browser
else echo "Voxen için Chrome veya Chromium gerekli." >&2; exit 1
fi

"$BROWSER" --app="http://127.0.0.1:$PORT/" --start-maximized --user-data-dir="$PROFILE_DIR" --class=VoxenPlayer
