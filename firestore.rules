rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User Liked Tracks
      match /likedTracks/{trackId} {
        allow read, write: if isOwner(userId);
      }

      // User Followed Artists
      match /followedArtists/{artistId} {
        allow read, write: if isOwner(userId);
      }

      // User Following / Followers
      match /followingUsers/{targetUid} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      match /followers/{followerUid} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == followerUid;
      }

      // User Listening History
      match /history/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // In-App Notifications
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated(); // Allowed to deliver notification to user
      }

      // Generated Daily Mixes
      match /generatedMixes/{date} {
        allow read, write: if isOwner(userId);
      }

      // User Preferences & Settings
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /publicProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoURL', 'bio',
          'profileVisibility', 'showPublicPlaylists', 'playlists'
        ]);
      allow delete: if isOwner(userId);
    }

    // Username reservation table for unique username enforcement
    match /usernames/{username} {
      allow read: if true; // anyone can check if username is available
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated()
                    && resource.data.uid == request.auth.uid;
    }

    // Playlists
    match /playlists/{playlistId} {
      function isPlaylistOwner() {
        return isAuthenticated() && resource.data.ownerId == request.auth.uid;
      }

      function isCollaborator() {
        return isAuthenticated() &&
               resource.data.collaborative == true &&
               (request.auth.uid in resource.data.collaborators);
      }

      allow read: if resource.data.visibility == 'public'
                  || resource.data.visibility == 'unlisted'
                  || isPlaylistOwner()
                  || isCollaborator();

      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated() && (
        isPlaylistOwner() ||
        (isCollaborator() &&
         request.resource.data.ownerId == resource.data.ownerId &&
         request.resource.data.visibility == resource.data.visibility)
      );

      allow delete: if isPlaylistOwner();

      // Playlist tracks subcollection
      match /tracks/{trackEntryId} {
        allow read: if get(/databases/$(database)/documents/playlists/$(playlistId)).data.visibility in ['public', 'unlisted']
                    || get(/databases/$(database)/documents/playlists/$(playlistId)).data.ownerId == request.auth.uid
                    || (get(/databases/$(database)/documents/playlists/$(playlistId)).data.collaborative == true &&
                        request.auth.uid in get(/databases/$(database)/documents/playlists/$(playlistId)).data.collaborators);

        allow write: if isAuthenticated() && (
          get(/databases/$(database)/documents/playlists/$(playlistId)).data.ownerId == request.auth.uid ||
          (get(/databases/$(database)/documents/playlists/$(playlistId)).data.collaborative == true &&
           request.auth.uid in get(/databases/$(database)/documents/playlists/$(playlistId)).data.collaborators)
        );
      }
    }

    // Real-time Listening Rooms
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.hostUid == request.auth.uid
                    && request.resource.data.hostUid == resource.data.hostUid;
      allow delete: if isAuthenticated() && resource.data.hostUid == request.auth.uid;
    }
  }
}
